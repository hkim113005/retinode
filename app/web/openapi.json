      "JobStatus": {
        "description": "A background job's state, polled by the client. When ``status`` is ``\"done\"``,\nthe matching result is present \u2014 ``scorecard`` for a score job, ``field`` (+\n``max_divergence_pct`` vs the analytical preview) for an accurate-field job.\n``cached`` means it was served from a prior identical run (P7 S3).",
        "properties": {
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
