{
  "components": {
    "schemas": {
      "ActivationCurve": {
        "description": "One cell's response across the sweep's amplitude grid, aligned index-for-index\nwith ``AmplitudeSweepResponse.amplitudes_uA``.\n\nNote there is deliberately no \"activation fraction\" here. The patch is a target\nplus its bystanders \u2014 a handful of cells \u2014 so a fraction would be a two- or\nthree-level step function wearing the costume of a sigmoid. Per-cell traces are\nwhat the engine actually knows.",
        "properties": {
          "activated": {
            "items": {
              "type": "boolean"
            },
            "title": "Activated",
            "type": "array"
          },
          "blocks": {
            "default": false,
            "title": "Blocks",
            "type": "boolean"
          },
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "crossing_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crossing Ua"
          },
          "initiation_region": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Initiation Region",
            "type": "array"
          },
          "is_target": {
            "title": "Is Target",
            "type": "boolean"
          }
        },
        "required": [
          "cell_id",
          "is_target",
          "activated",
          "initiation_region"
        ],
        "title": "ActivationCurve",
        "type": "object"
      },
      "AmplitudeSweepResponse": {
        "properties": {
          "amplitudes_uA": {
            "items": {
              "type": "number"
            },
            "title": "Amplitudes Ua",
            "type": "array"
          },
          "curves": {
            "items": {
              "$ref": "#/components/schemas/ActivationCurve"
            },
            "title": "Curves",
            "type": "array"
          }
        },
        "required": [
          "amplitudes_uA",
          "curves"
        ],
        "title": "AmplitudeSweepResponse",
        "type": "object"
      },
      "Body_upload_cad_cad_post": {
        "properties": {
          "file": {
