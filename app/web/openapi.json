        ],
        "title": "StudyResult",
        "type": "object"
      },
      "SweepControls": {
        "description": "An amplitude sweep of the scene: who fires, at what current.",
        "properties": {
          "amp_max_uA": {
            "default": 200.0,
            "exclusiveMinimum": 0.0,
            "title": "Amp Max Ua",
            "type": "number"
          },
          "amp_min_uA": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Amp Min Ua",
            "type": "number"
          },
          "body": {
            "discriminator": {
              "mapping": {
                "cad": "#/components/schemas/CadBodySpec",
                "cylinder": "#/components/schemas/CylinderBody",
                "frustum": "#/components/schemas/FrustumBody",
                "hemisphere": "#/components/schemas/HemisphereBody",
                "none": "#/components/schemas/NoBody"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/NoBody"
              },
              {
                "$ref": "#/components/schemas/HemisphereBody"
              },
              {
                "$ref": "#/components/schemas/CylinderBody"
              },
              {
                "$ref": "#/components/schemas/FrustumBody"
              },
              {
                "$ref": "#/components/schemas/CadBodySpec"
              }
            ],
            "title": "Body"
          },
          "electrode_um": {
            "default": 10.0,
            "exclusiveMinimum": 0.0,
            "title": "Electrode Um",
            "type": "number"
          },
          "extent_um": {
            "default": 130.0,
            "exclusiveMinimum": 0.0,
            "title": "Extent Um",
            "type": "number"
          },
          "include_scorecard": {
            "default": false,
            "title": "Include Scorecard",
            "type": "boolean"
          },
          "layout": {
            "default": "single",
            "enum": [
              "single",
              "bipolar"
            ],
            "title": "Layout",
            "type": "string"
          },
          "n": {
            "default": 61,
            "maximum": 257.0,
            "minimum": 9.0,
            "title": "N",
            "type": "integer"
          },
          "n_amplitudes": {
            "default": 24,
            "maximum": 60.0,
            "minimum": 2.0,
            "title": "N Amplitudes",
            "type": "integer"
          },
          "neighbor_um": {
            "default": 40.0,
            "exclusiveMinimum": 0.0,
            "title": "Neighbor Um",
            "type": "number"
          },
          "overlap_policy": {
            "default": "reject",
            "enum": [
              "reject",
              "displace"
            ],
            "title": "Overlap Policy",
            "type": "string"
          },
          "phase_width_us": {
            "default": 200.0,
            "exclusiveMinimum": 0.0,
            "title": "Phase Width Us",
            "type": "number"
          },
          "pitch_um": {
            "default": 60.0,
            "exclusiveMinimum": 0.0,
            "title": "Pitch Um",
            "type": "number"
          },
          "sigma_S_per_m": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Sigma S Per M",
            "type": "number"
          },
          "spacing": {
            "default": "linear",
            "enum": [
              "linear",
              "log"
            ],
            "title": "Spacing",
            "type": "string"
          }
        },
        "title": "SweepControls",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationReport": {
        "description": "The trust panel: which reproductions currently pass (master plan \u00a715). This is\nthe committed report CI regenerates \u2014 the app renders it, never recomputes it.",
        "properties": {
          "n_pass": {
            "title": "N Pass",
            "type": "integer"
          },
          "n_total": {
            "title": "N Total",
            "type": "integer"
          },
          "reproductions": {
            "items": {
              "$ref": "#/components/schemas/ValidationReproduction"
            },
            "title": "Reproductions",
            "type": "array"
          }
        },
        "required": [
          "n_pass",
          "n_total",
          "reproductions"
        ],
        "title": "ValidationReport",
        "type": "object"
      },
      "ValidationReproduction": {
        "description": "One published/physics check the engine reproduces, and how it was measured.",
        "properties": {
          "criterion": {
            "title": "Criterion",
            "type": "string"
          },
          "measured": {
            "title": "Measured",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "name",
          "source",
          "passed",
          "measured",
          "criterion"
        ],
        "title": "ValidationReproduction",
        "type": "object"
      }
    }
  },
