{
  "components": {
    "schemas": {
      "CellMarker": {
        "description": "A soma position on the field plane; the target is drawn filled.",
        "properties": {
          "is_target": {
            "title": "Is Target",
            "type": "boolean"
          },
          "x_um": {
            "title": "X Um",
            "type": "number"
          },
          "y_um": {
            "title": "Y Um",
            "type": "number"
          }
        },
        "required": [
          "x_um",
          "y_um",
          "is_target"
        ],
        "title": "CellMarker",
        "type": "object"
      },
      "CompareResponse": {
        "description": "One configuration scored for the Compare screen: the field and its scene\noverlays always, the scorecard only when requested (it costs a threshold\nsearch). This is the field-view data contract \u2014 grid + electrode outlines +\nsoma overlays (master plan \u00a716).",
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/CellMarker"
            },
            "title": "Cells",
            "type": "array"
          },
          "electrodes": {
            "items": {
              "$ref": "#/components/schemas/ElectrodeMarker"
            },
            "title": "Electrodes",
            "type": "array"
          },
          "field": {
            "$ref": "#/components/schemas/FieldGridResponse"
          },
          "scorecard": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScorecardResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "field",
          "electrodes",
          "cells"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
      "ElectrodeMarker": {
        "description": "An electrode's footprint on the field plane, for the overlay.",
        "properties": {
          "radius_um": {
            "title": "Radius Um",
            "type": "number"
          },
          "x_um": {
            "title": "X Um",
            "type": "number"
          },
          "y_um": {
            "title": "Y Um",
            "type": "number"
          }
        },
        "required": [
          "x_um",
          "y_um",
          "radius_um"
        ],
        "title": "ElectrodeMarker",
        "type": "object"
      },
      "FieldGridResponse": {
        "description": "Ve (mV) on a square grid at the cell plane \u2014 the analytical field preview.",
        "properties": {
          "ve_mV": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Ve Mv",
            "type": "array"
          },
          "vmax_mV": {
            "title": "Vmax Mv",
            "type": "number"
          },
          "xs_um": {
            "items": {
              "type": "number"
            },
            "title": "Xs Um",
            "type": "array"
          },
          "ys_um": {
            "items": {
              "type": "number"
            },
            "title": "Ys Um",
            "type": "array"
          }
        },
        "required": [
          "xs_um",
          "ys_um",
          "ve_mV",
          "vmax_mV"
        ],
        "title": "FieldGridResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobStatus": {
        "description": "A background job's state, polled by the client. When ``status`` is ``\"done\"``,\nthe matching result is present \u2014 ``scorecard`` for a score job, ``field`` (+\n``max_divergence_pct`` vs the analytical preview) for an accurate-field job.\n``cached`` means it was served from a prior identical run (P7 S3).",
        "properties": {
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "field": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FieldGridResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "fraction": {
            "title": "Fraction",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "max_divergence_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Divergence Pct"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "scorecard": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScorecardResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "running",
              "done",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "study": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StudyResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "fraction",
          "message"
        ],
        "title": "JobStatus",
        "type": "object"
      },
      "SceneControls": {
        "description": "The Compare screen's inputs \u2014 the same handful of controls the Dash app\nexposes, translated to specs server-side via ``app.scene.build_scene``.",
        "properties": {
          "electrode_um": {
            "default": 10.0,
            "exclusiveMinimum": 0.0,
            "title": "Electrode Um",
            "type": "number"
          },
          "extent_um": {
            "default": 130.0,
            "exclusiveMinimum": 0.0,
            "title": "Extent Um",
            "type": "number"
          },
          "include_scorecard": {
            "default": false,
            "title": "Include Scorecard",
            "type": "boolean"
          },
          "layout": {
            "default": "single",
            "enum": [
              "single",
              "bipolar"
            ],
            "title": "Layout",
            "type": "string"
          },
          "n": {
            "default": 61,
            "maximum": 257.0,
            "minimum": 9.0,
            "title": "N",
            "type": "integer"
          },
          "neighbor_um": {
            "default": 40.0,
            "exclusiveMinimum": 0.0,
            "title": "Neighbor Um",
            "type": "number"
          },
          "phase_width_us": {
            "default": 200.0,
            "exclusiveMinimum": 0.0,
            "title": "Phase Width Us",
            "type": "number"
          },
          "pitch_um": {
            "default": 60.0,
            "exclusiveMinimum": 0.0,
            "title": "Pitch Um",
            "type": "number"
          },
          "sigma_S_per_m": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Sigma S Per M",
            "type": "number"
          }
        },
        "title": "SceneControls",
        "type": "object"
      },
      "ScorecardResponse": {
        "description": "The evaluator's operating-window verdict. ``activated=False`` means the\ntarget never fired in the searched range and every other field is absent.",
        "properties": {
          "activated": {
            "title": "Activated",
            "type": "boolean"
          },
          "limiting": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limiting"
          },
          "limiting_off_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limiting Off Id"
          },
          "off_min_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Off Min Ua"
          },
          "off_target_thresholds_uA": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Off Target Thresholds Ua"
          },
          "offtarget_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offtarget Hash"
          },
          "ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ratio"
          },
          "safe_at_target": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe At Target"
          },
          "safety_ceiling_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Ceiling Ua"
          },
          "target_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Ua"
          },
          "usable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usable"
          },
          "usable_margin_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usable Margin Ua"
          },
          "window_hi_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Hi Ua"
          },
          "window_lo_uA": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Lo Ua"
          }
        },
        "required": [
          "activated"
        ],
        "title": "ScorecardResponse",
        "type": "object"
      },
      "StudyControls": {
        "description": "A geometry sweep: the diameter \u00d7 pitch grid to explore, plus the patch it is\nscored on. Combos with ``pitch < diameter`` (which would overlap) are dropped.",
        "properties": {
          "aperture_um": {
            "default": 120.0,
            "minimum": 0.0,
            "title": "Aperture Um",
            "type": "number"
          },
          "arrangement": {
            "default": "hex",
            "enum": [
              "grid",
              "hex"
            ],
            "title": "Arrangement",
            "type": "string"
          },
          "diameters_um": {
            "items": {
              "type": "number"
            },
            "title": "Diameters Um",
            "type": "array"
          },
          "neighbor_um": {
            "default": 40.0,
            "exclusiveMinimum": 0.0,
            "title": "Neighbor Um",
            "type": "number"
          },
          "phase_width_us": {
            "default": 200.0,
            "exclusiveMinimum": 0.0,
            "title": "Phase Width Us",
            "type": "number"
          },
          "pitches_um": {
            "items": {
              "type": "number"
            },
            "title": "Pitches Um",
            "type": "array"
          },
          "sigma_S_per_m": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Sigma S Per M",
            "type": "number"
          }
        },
        "title": "StudyControls",
        "type": "object"
      },
      "StudyPoint": {
        "description": "One evaluated geometry on the selectivity-versus-cost plane.",
        "properties": {
          "cost_uA": {
            "title": "Cost Ua",
            "type": "number"
          },
          "diameter_um": {
            "title": "Diameter Um",
            "type": "number"
          },
          "on_frontier": {
            "title": "On Frontier",
            "type": "boolean"
          },
          "pitch_um": {
            "title": "Pitch Um",
            "type": "number"
          },
          "safe": {
            "title": "Safe",
            "type": "boolean"
          },
          "selectivity_uA": {
            "title": "Selectivity Ua",
            "type": "number"
          }
        },
        "required": [
          "diameter_um",
          "pitch_um",
          "cost_uA",
          "selectivity_uA",
          "safe",
          "on_frontier"
        ],
        "title": "StudyPoint",
        "type": "object"
      },
      "StudyResult": {
        "description": "A completed sweep: every activated geometry, and how many were swept.",
        "properties": {
          "n_geometries": {
            "title": "N Geometries",
            "type": "integer"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/StudyPoint"
            },
            "title": "Points",
            "type": "array"
          }
        },
        "required": [
          "points",
          "n_geometries"
        ],
        "title": "StudyResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationReport": {
        "description": "The trust panel: which reproductions currently pass (master plan \u00a715). This is\nthe committed report CI regenerates \u2014 the app renders it, never recomputes it.",
        "properties": {
          "n_pass": {
            "title": "N Pass",
            "type": "integer"
          },
          "n_total": {
            "title": "N Total",
            "type": "integer"
          },
          "reproductions": {
            "items": {
              "$ref": "#/components/schemas/ValidationReproduction"
            },
            "title": "Reproductions",
            "type": "array"
          }
        },
        "required": [
          "n_pass",
          "n_total",
          "reproductions"
        ],
        "title": "ValidationReport",
        "type": "object"
      },
      "ValidationReproduction": {
        "description": "One published/physics check the engine reproduces, and how it was measured.",
        "properties": {
          "criterion": {
            "title": "Criterion",
            "type": "string"
          },
          "measured": {
            "title": "Measured",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "name",
          "source",
          "passed",
          "measured",
          "criterion"
        ],
        "title": "ValidationReproduction",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Retinode API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/compare": {
      "post": {
        "operationId": "compare_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SceneControls"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compare"
      }
    },
    "/field/accurate": {
      "post": {
        "operationId": "submit_accurate_field_field_accurate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SceneControls"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Accurate Field"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job"
      }
    },
    "/score": {
      "post": {
        "operationId": "submit_score_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SceneControls"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Score"
      }
    },
    "/study": {
      "post": {
        "operationId": "submit_study_study_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudyControls"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Study"
      }
    },
    "/validation": {
      "get": {
        "operationId": "get_validation_validation_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Validation"
      }
    }
  }
}
