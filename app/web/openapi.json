        "title": "Body_upload_cad_cad_post",
        "type": "object"
      },
      "CadBodySpec": {
        "description": "An imported STEP/BREP solid, referenced by the id ``POST /cad`` returned. The\ngmsh load lives in the FEM env, so the id resolves to a file there, not here.",
        "properties": {
          "conductive_faces": {
            "default": "all",
            "enum": [
              "tip",
              "sides",
              "all"
            ],
            "title": "Conductive Faces",
            "type": "string"
          },
          "kind": {
            "const": "cad",
            "default": "cad",
            "title": "Kind",
            "type": "string"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id"
        ],
        "title": "CadBodySpec",
        "type": "object"
      },
      "CadUploadResponse": {
        "description": "The id ``POST /cad`` hands back for a stored solid, plus its original name.\n\nThe bounding dimensions are measured once at upload, in the FEM env (reading a\nSTEP needs gmsh). They are ``None`` when that env is unavailable \u2014 the upload\nstill succeeds; only the shape preview is unavailable, and the client says so\nrather than drawing a flat disk and letting it pass for the real solid.",
        "properties": {
          "bounding_height_um": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bounding Height Um"
          },
          "bounding_radius_um": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bounding Radius Um"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "filename"
        ],
        "title": "CadUploadResponse",
        "type": "object"
      },
      "CellMarker": {
        "description": "A soma position on the field plane; the target is drawn filled.",
